import cnc_bMd from '../../../analysis/601998-cnc-b.md?raw';
import sungrowMd from '../../../analysis/300274-sungrow.md?raw';
import sinotrukMd from '../../../analysis/000951-sinotruk.md?raw';
const reportByCode: Record<string, string> = {
  '000333': mideaMd,
  '300750': catlMd,
  '002371': nauraMd,
  '600036': cmbMd,
  '300308': innocloudMd,
  '600030': citic_secMd,
  '601166': industrial_bankMd,
  '601288': abcMd,
  '000338': weichaiMd,
  '600887': yiliMd,
  '601318': ping_anMd,
  '601398': icbcMd,
  '600919': jiangsu_bankMd,
  '300502': eoptolinkMd,
  '002714': muyuanMd,
  '002142': bank_of_ningboMd,
  '603259': wuxi_apptecMd,
  '601939': ccbMd,
  '002602': century_huatongMd,
  '002463': hsccMd,
  '601988': bocMd,
