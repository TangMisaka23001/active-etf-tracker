const fileName: Record<string, string> = {
  '000333': '000333-midea.md',
  '300750': '300750-catl.md',
  '002371': '002371-naura.md',
  '600036': '600036-cmb.md',
  '300308': '300308-innocloud.md',
  '600030': '600030-citic-sec.md',
  '601166': '601166-industrial-bank.md',
  '601288': '601288-abc.md',
  '000338': '000338-weichai.md',
  '600887': '600887-yili.md',
  '601318': '601318-ping-an.md',
  '601398': '601398-icbc.md',
  '600919': '600919-jiangsu-bank.md',
  '300502': '300502-eoptolink.md',
  '002714': '002714-muyuan.md',
  '002142': '002142-bank-of-ningbo.md',
  '603259': '603259-wuxi-apptec.md',
  '601939': '601939-ccb.md',
  '002602': '002602-century-huatong.md',
  '002463': '002463-hscc.md',
  '601988': '601988-boc.md',
  '002415': '002415-hikvision.md',
  '601919': '601919-cosco-shipping.md',
  '601225': '601225-shaanxi-coal.md',
