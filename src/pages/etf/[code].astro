---
import Layout from '../../layouts/Layout.astro';
import etfs from '../../data/etfs.json';
import verdicts from '../../data/stock-verdicts.json';
import holdings from '../../data/top-holdings.json';
import fundGrades from '../../data/fund-grades.json';
import { mdToHtml } from '../../lib/md';
import latest from '../../../public/data/latest.json';
import history from '../../../public/data/history.json';
import { readFileSync, existsSync } from 'node:fs';
import { join, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

export function getStaticPaths() {
  return etfs.map((e) => ({ params: { code: e.code }, props: { etf: e } }));
}
const { etf } = Astro.props;
const q = (latest.etfs ?? {})[etf.code];
const pcf = (latest.pcfStatus ?? {})[etf.code];
const sh = (latest.shares ?? {})[etf.code];
const days = (history.days ?? []).filter((d) => d.etfs?.[etf.code]);

// 最新一天的 PCF 快照（如果当天抓取成功）
let pcfSnap = null;
if (latest.date) {
  const p = join(dirname(fileURLToPath(import.meta.url)), '../../../public/data/pcf', latest.date, `${etf.code}.json`);
  if (existsSync(p)) {
    try { pcfSnap = JSON.parse(readFileSync(p, 'utf8')); } catch { pcfSnap = null; }
  }
}
const cls = (v) => (v == null ? 'flat' : v > 0 ? 'up' : v < 0 ? 'down' : 'flat');
const fmt = (v, suffix = '') => (v == null ? '—' : `${v > 0 ? '+' : ''}${Number(v).toFixed(2)}${suffix}`);
const analyzedCount = pcfSnap ? pcfSnap.top.filter((t) => verdicts[t.code]).length : 0;
const turtleByCode: Record<string, { companyUrl: string; reportCount: number } | null> = {};
for (const s of holdings.stocks) turtleByCode[s.code] = s.turtleTurtle ?? null;
const grade = fundGrades.grades[etf.code];
const gradeCls = (gr: string) => (gr === 'A' ? 'grade-a' : gr === 'C' ? 'grade-c' : 'grade-b');
const gradeLabel = (gr: string) => (gr === 'A' ? 'A 优秀' : gr === 'B' ? 'B 一般' : 'C 差');
---

<Layout title={`${etf.short}（${etf.code}）| 主动ETF追踪`}>
  <p><a href={`${import.meta.env.BASE_URL}`}>← 回到18只总榜</a></p>
  <h1>{etf.name}</h1>
  <p class="lede">
    {etf.manager} · {etf.exchange === 'SSE' ? '上交所' : '深交所'} · {etf.style}风格
    {etf.benchmark ? ` · 业绩比较基准：${etf.benchmark}` : ''}
    · 上市日期 {etf.listingDate} · 上市前仓位（2026-11-16）：{etf.position20261116}%
  </p>

  {q ? (
    <div class="cards">
      <div class="card"><div class="k">最新价（{latest.date}）</div><div class="v">{q.price.toFixed(3)}</div><div class="d">前收 {q.prevClose?.toFixed(3) ?? '—'}</div></div>
      <div class="card"><div class="k">当日涨跌</div><div class={`v ${cls(q.changePct)}`}>{fmt(q.changePct, '%')}</div><div class="d">来源：{q.source}</div></div>
      <div class="card"><div class="k">成交量 / 成交额</div><div class="v" style="font-size:16px">{q.volume != null ? `${(q.volume / 10000).toFixed(2)}万手` : '—'}</div><div class="d">{q.turnover != null ? `成交额 ${q.turnover.toLocaleString()}万元` : ''}</div></div>
      <div class="card"><div class="k">PCF 状态</div><div class="v" style="font-size:16px">{pcf?.status === 'ok' ? `✓ ${pcf.componentCount}只成分` : pcf?.status === 'failed' ? '✗ 失败' : '—'}</div><div class="d">{pcf?.tradingDay ? `PCF 交易日 ${pcf.tradingDay}` : pcf?.error ?? ''}</div></div>
      <div class="card"><div class="k">基金份额{sh ? `（${sh.date}）` : ''}</div><div class="v" style="font-size:16px">{sh ? `${(sh.shares10k / 10000).toFixed(2)}亿份` : '—'}</div><div class={`d ${cls(sh?.changePct)}`}>{sh?.change10k != null ? `较上期 ${sh.change10k > 0 ? '+' : ''}${Math.round(sh.change10k).toLocaleString()}万份 (${sh.changePct > 0 ? '+' : ''}${sh.changePct?.toFixed(2)}%)` : '首期份额记录，暂无增减'}</div></div>
    </div>
  ) : (
    <div class="note">还没有当日行情。跑一次 <code>npm run fetch</code> 或等每日定时任务后，这里会有价格与 PCF。</div>
  )}

  <h2>PCF 持仓 Top20（{pcfSnap ? `${pcfSnap.date}，${pcfSnap.source}` : '暂无快照'}）</h2>
  {pcfSnap ? (
    <>
      {pcfSnap.changes && (pcfSnap.changes.added.length || pcfSnap.changes.removed.length || pcfSnap.changes.weightChanged.length) ? (
        <div class="note">
          <strong>相对上一日快照的变动：</strong>
          {pcfSnap.changes.added.length ? <div>新增：{pcfSnap.changes.added.map((a) => `${a.name}（${a.code}，${a.weightPct ?? '—'}%）`).join('、')}</div> : null}
          {pcfSnap.changes.removed.length ? <div>剔除：{pcfSnap.changes.removed.map((a) => `${a.name}（${a.code}）`).join('、')}</div> : null}
          {pcfSnap.changes.weightChanged.map((a) => (
            <div>权重变化≥0.5pp：{a.name}（{a.code}）{a.from}% → {a.to}%（{a.delta > 0 ? '+' : ''}{a.delta}pp）</div>
          ))}
        </div>
      ) : (
        <p class="lede">相对上一日快照：Top20 无新增/剔除、无权重变化≥0.5个百分点的成分（或这是第一份快照）。</p>
      )}
      {analyzedCount > 0 && (
        <p class="lede">
          其中 {analyzedCount} 只已有龟龟方法分析（V5.2.2，研究截止日 2026-11-24），价格条件见下表，点“分析”进该股票的独立分析页；其中在赛博龟龟陪审团站内有收录报告的，表里另有“几份报告”外链。
        </p>
      )}
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>股票代码</th><th>股票名称</th><th>权重</th><th>数量/份数</th><th>价格条件</th></tr></thead>
          <tbody>
            {pcfSnap.top.map((t) => (
              <tr>
                <td><code>{t.code}</code></td>
                <td>{t.name}</td>
                <td>{t.weightPct != null ? `${Number(t.weightPct).toFixed(2)}%` : '—'}</td>
                <td>{t.quantity ?? '—'}</td>
                <td>
                  {verdicts[t.code] ? (
                    <>
                      {verdicts[t.code].price === 'pass' ? (
                        <span class="badge ok">通过</span>
                      ) : (
                        <span class="badge fail">未通过</span>
                      )}{' '}
                      {verdicts[t.code].priceDetail} ·{' '}
                      <a href={`${import.meta.env.BASE_URL}stocks/${t.code}`}>分析 →</a>
                      {turtleByCode[t.code] ? (
                        <>
                          {' '}·{' '}
                          <a href={turtleByCode[t.code].companyUrl} target="_blank" rel="noopener">
                            {turtleByCode[t.code].reportCount} 份报告 →
                          </a>
                        </>
                      ) : null}
                    </>
                  ) : (
                    '—'
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="lede">权重口径：上交所为 PCF 现金替代金额 / 每申购赎回单位净值；深交所为成分股份数 × 成分股现价 / 每单位净值（股价拉不到时权重留空，只保留份数）。PCF 是申赎篮子估算，不等同精确持仓。</p>
    </>
  ) : (
    <p class="lede">暂无 PCF 快照。深交所 / 上交所接口偶有失败时，状态会记在最新数据里，不阻塞其它 17 只。</p>
  )}

  {grade && (
    <>
      <h2>长赢持仓评价（{fundGrades.cutoff}）</h2>
      <p class="lede">
        <span class={`badge ${gradeCls(grade.grade)}`}>{gradeLabel(grade.grade)}</span>{' '}
        {grade.brief}
      </p>
      <div class="analysis" set:html={mdToHtml(grade.detail)} />
      <p class="lede">评价方法：且慢长赢方法（估值 / 拥挤度 / 风险三线，加质量与分红、分散度、仓位），持仓为 {fundGrades.cutoff} PCF Top20 快照；股息率与 ROE 等数据以当时可核实的为准，未核实项见评价正文。</p>
    </>
  )}

  <h2>每日收盘价与份额历史</h2>
  {days.length ? (
    <div class="tbl-wrap">
      <table>
        <thead><tr><th>日期</th><th>收盘价</th><th>涨跌幅</th><th>基金份额（亿份）</th></tr></thead>
        <tbody>
          {[...days].reverse().map((d) => (
            <tr><td>{d.date}</td><td>{d.etfs[etf.code].price.toFixed(3)}</td><td class={cls(d.etfs[etf.code].changePct)}>{fmt(d.etfs[etf.code].changePct, '%')}</td><td>{d.shares?.[etf.code]?.shares10k != null ? (d.shares[etf.code].shares10k / 10000).toFixed(2) : '—'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="lede">暂无历史。每日抓取会把每一天追加到 <code>public/data/history.json</code>。</p>
  )}
  <p class="lede">份额口径：上交所按日归档、深交所只有当前快照（T日晚为预估值、T+1早为确认值），所以份额日期可能比行情日期晚一天或早一天；份额增是申购、减是赎回。</p>
</Layout>
